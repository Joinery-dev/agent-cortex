#!/usr/bin/env bash
# cortex — run Agent Cortex from any directory.
#
# Usage:
#   cortex                          Start interactive session (in current project)
#   cortex "fix the auth bug"       Run a task
#   cortex --worldview groove       Use a specific worldview
#   cortex --help                   Show help

# Resolve symlinks to find the real script location
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  DIR="$(cd -P "$(dirname "$SCRIPT")" && pwd)"
  SCRIPT="$(readlink "$SCRIPT")"
  [[ "$SCRIPT" != /* ]] && SCRIPT="$DIR/$SCRIPT"
done
CORTEX_ROOT="$(cd -P "$(dirname "$SCRIPT")/.." && pwd)"

exec "${CORTEX_ROOT}/node_modules/.bin/tsx" "${CORTEX_ROOT}/src/cli.ts" "$@"
