---
title: The Core Loop
scope: global
---
flowchart TD
    task["🎯 Task Arrives\n'Build the homepage hero section'"]

    activate["⚙️ Basal Ganglia\nWhich senses care about this task?\nActivate relevant, suppress irrelevant"]

    distill["🧠 Thalamus\nAssemble context briefing\nfor this specific task"]

    consult["👁️ Senses Consult\nEach activated sense weighs in\nfrom its perspective"]

    explore["🔍 Explore\nGenerate divergent approaches\nselect best (or skip if routine)"]

    subgraph INNER["Build Cycle (inner loop)"]
        build["🔨 Motor Cortex\nPlans approach, produces work,\nself-corrects mid-build"]

        evaluate["📊 Evaluate\nEach receptor scores\nfrom competing perspectives"]

        gate{Gate accepts?}

        build --> evaluate --> gate
        gate -- "No → revise" --> build
    end

    improvement{"Improvement\npotential?"}

    done["✅ Complete\nWork + evaluations + decision log"]

    task --> activate --> distill --> consult --> explore --> INNER
    INNER --> improvement
    improvement -- "Senses re-consult\nafter seeing work" --> consult
    improvement -- "Done" --> done

    style task fill:#f9f0e6,stroke:#c4956a
    style activate fill:#e8f4e8,stroke:#6b9e6b
    style distill fill:#e6eef9,stroke:#6a8fc4
    style consult fill:#f0e6f9,stroke:#956ac4
    style explore fill:#e8f4e8,stroke:#6b9e6b
    style build fill:#f9e6e6,stroke:#c46a6a
    style evaluate fill:#f0e6f9,stroke:#956ac4
    style done fill:#e8f4e8,stroke:#6b9e6b
    style gate fill:#fff,stroke:#999
    style improvement fill:#fff,stroke:#999
    style INNER fill:#1a1d1a,stroke:#fb923c,color:#e2e4ea
