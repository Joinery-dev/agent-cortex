    style RESULTS fill:#f0fdf4,stroke:#16a34a,color:#1a1a2e
    style PFC fill:#fce7f3,stroke:#db2777,color:#1a1a2e
    style SUBCORT fill:#ffedd5,stroke:#ea580c,color:#1a1a2e
