---
title: "Escalation Pathways — When the System Asks for Help"
scope: global
---
flowchart TD
    subgraph SOURCES["What Triggers Escalation"]
        S1["DRIFT MONITOR<br/>Trajectory diverging<br/>from manifested future"]
        S2["COGNITIVE FLEXIBILITY<br/>Perseveration detected:<br/>same approach, no improvement"]
        S3["AMYGDALA<br/>Threat detected:<br/>security, data loss, unsafe op"]
        S4["ATTENTION SCHEDULER<br/>Deadlock: no ready tasks<br/>but graph not done"]
        S5["CONVICTION LOOP<br/>Conviction too low to proceed<br/>or manifested future broken"]
        S6["HOMEOSTASIS<br/>Learning signal broken<br/>or tonic dopamine crashed"]
        S7["BUILD CYCLE<br/>Too many open questions<br/>or scores cratering"]
    end

    subgraph LEVELS["Escalation Severity"]
        L1["SOFT<br/>Wait for current gate,<br/>then surface for decision<br/>(medium urgency)"]
        L2["HARD<br/>Freeze immediately,<br/>escalate to human<br/>(critical urgency)"]
    end

    subgraph HANDLER["Escalation Handler"]
        H1["Pause all rhythms"]
        H2["Assemble human briefing:<br/>what happened, why,<br/>what options exist"]
        H3["Present to human<br/>via PNS"]
    end

    subgraph RESOLUTION["Human Resolves"]
        R1["CONTINUE<br/>'Keep going, it's fine'<br/>→ resume with<br/>conviction boost"]
        R2["REDIRECT<br/>'Try this instead'<br/>→ reshape: replan<br/>from new direction"]
        R3["ABORT<br/>'Stop this task/project'<br/>→ deliver what's done"]
        R4["ANSWER<br/>'The answer is X'<br/>→ resolve open question,<br/>resume"]
    end

    S1 --> L1
    S2 --> L1
    S4 --> L1
    S5 --> L1
    S6 --> L1
    S7 --> L1
    S3 --> L2

    L1 --> H1
    L2 --> H1
    H1 --> H2 --> H3
    H3 --> R1 & R2 & R3 & R4

    R1 --> RESUME["Resume rhythm"]
    R2 --> REPLAN["Invoke planner"]
    R3 --> COMPLETE["Deliver + complete"]
    R4 --> RESUME

    style SOURCES fill:#1a1d27,stroke:#f87171,color:#e2e4ea
    style LEVELS fill:#1a1d27,stroke:#facc15,color:#e2e4ea
    style HANDLER fill:#1a1d27,stroke:#60a5fa,color:#e2e4ea
    style RESOLUTION fill:#1a1d27,stroke:#4ade80,color:#e2e4ea
