flowchart TB
    subgraph human_layer["Human Layer"]
        human["Human"]
        intent_cap["Intent\nWhat are we building and why?"]
        taste_cap["Taste\nHow should ambiguous decisions go?"]
    end

    subgraph cortex["The Cortex"]
        orchestrator["Orchestrator\nThe main loop"]

        subgraph neural["Sensory Layer"]
            library["Sensory Cortex\nSenses at multiple scales"]
            activator["Activator\nCascading relevance check"]
        end

        distiller["Distiller\nContextual dissolution\nIntent + Taste + Task → Judgment"]

        motor["Motor Cortex\nProduces work guided by briefing"]

        subgraph evaluation["Evaluation"]
            evaluator["Evaluator\nSenses score through their lens"]
            resolver["Resolver\nFind creative synthesis\nfor competing perspectives"]
        end
    end

    subgraph output["Output"]
        work["Work Product"]
        decisions["Decision Log\nConfidence-scored"]
        tensions_log["Resolved Tensions"]
    end

    human --> intent_cap & taste_cap
    intent_cap & taste_cap --> orchestrator
    orchestrator --> activator
    activator --> library
    library --> activator
    activator --> distiller
    intent_cap & taste_cap --> distiller
    distiller --> motor
    motor --> evaluator
    evaluator --> resolver
    resolver --> motor
    resolver --> orchestrator
    orchestrator --> output

