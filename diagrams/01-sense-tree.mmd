flowchart LR
    TITLE["<b>THE 11 SENSES — COMPETING PERSPECTIVES</b><br/>How the system evaluates from every angle"]
    style TITLE fill:#f8fafc,stroke:#94a3b8,color:#1a1a2e

    TITLE --> ROOT

    ROOT["SENSORY CORTEX<br/>11 senses, each a persona<br/>with internalized values"]

    subgraph CRAFT["Craft & Form"]
        DESIGN["DESIGN<br/>Visual identity, layout,<br/>UX, interaction, motion,<br/>emotional resonance,<br/>accessibility"]
        CONTENT["CONTENT CRAFT<br/>Voice, readability,<br/>structure, editing,<br/>audience calibration"]
        DX["DEV EXPERIENCE<br/>API design, error messages,<br/>documentation, defaults,<br/>migration, SDK ergonomics"]
    end

    subgraph INTEGRITY["Integrity & Trust"]
        CORRECT["CORRECTNESS<br/>Functional, data integrity,<br/>concurrency, API contracts,<br/>error recovery"]
        SECURITY["SECURITY<br/>Input safety, data protection,<br/>auth, client-side, infra,<br/>supply chain"]
        RELIABLE["RELIABILITY<br/>Uptime, failover, monitoring,<br/>alerting, disaster recovery,<br/>health checks"]
    end

    subgraph PURPOSE["Purpose & Reach"]
        INTENT["INTENT ALIGNMENT<br/>Value proposition,<br/>audience fit, scope,<br/>conversion, stakeholder"]
        SEO["SEO & DISCOVERY<br/>Meta tags, structured data,<br/>crawlability, social sharing,<br/>speed signals"]
        I18N["INTERNATIONALIZATION<br/>Language support, RTL,<br/>formatting, cultural<br/>adaptation, translation"]
    end

    subgraph ENGINE["Engine & Efficiency"]
        PERF["PERFORMANCE<br/>Page load, assets, runtime,<br/>network, perceived,<br/>mobile, constrained"]
        MAINTAIN["MAINTAINABILITY<br/>Code quality, architecture,<br/>naming, documentation,<br/>dependency hygiene,<br/>technical debt"]
    end

    ROOT --> CRAFT
    ROOT --> INTEGRITY
    ROOT --> PURPOSE
    ROOT --> ENGINE

    CRAFT -.-> TENSION
    INTEGRITY -.-> TENSION
    PURPOSE -.-> TENSION
    ENGINE -.-> TENSION

    TENSION(("TENSIONS arise<br/>when senses disagree<br/>→ resolved by<br/>SYNTHESIS<br/>not averaging"))

