---
title: "Proactive Discovery — Finding Problems Before They Find You"
scope: global
---
flowchart TD
    subgraph OBSERVE["TERRITORY OBSERVATIONS — Passive Signals"]
        O1["Motor Cortex notices<br/>something odd while building<br/>(unexpected file structure,<br/>stale dependency, odd pattern)"]
        O2["Evaluators notice<br/>something outside their<br/>dimension's scope"]
        O3["Drift Monitor detects<br/>convention breaking<br/>or taste divergence"]
        O4["Observations stored<br/>in Working Memory<br/>(not acted on yet)"]
    end

    subgraph SIMULATE["HIPPOCAMPAL SIMULATION — What Could Happen?"]
        S1["Episodes of similar<br/>observations from past projects"]
        S2["'Last time we saw this pattern,<br/>the deploy failed 3 tasks later'"]
        S3["Simulated outcome:<br/>risk level + likely impact<br/>+ how many tasks away"]
    end

    subgraph TRIAGE["PFC SYNTHESIS — Two Speeds"]
        T1["QUICK TRIAGE<br/>(after every task)<br/>Scan observations + simulations<br/>→ anything urgent?"]
        T2["DEEP PHASE-GATE ANALYSIS<br/>(at phase boundaries)<br/>Full cross-task coherence check<br/>→ integration issues?"]
    end

    subgraph ACT["GRAPH SURGERY — Signal, Don't Act"]
        A1["Add task to graph<br/>(new dependency discovered)"]
        A2["Reorder tasks<br/>(risk moved earlier)"]
        A3["Flag for human<br/>(ambiguity or high risk)"]
        A4["Inject integration check<br/>(coherence concern)"]
    end

    O1 & O2 & O3 --> O4
    O4 --> S1 --> S2 --> S3
    S3 --> T1
    T1 -->|"nothing urgent"| WAIT["Continue task dispatch"]
    T1 -->|"something found"| ACT
    T2 --> ACT

    NOTE["Key principle:<br/>SIGNAL, don't act.<br/>Discovery identifies problems.<br/>The Attention Scheduler<br/>decides when to fix them."]

