---
title: "Gate Strategies — How the Build Cycle Decides"
scope: global
---
flowchart TD
    GATE["BUILD CYCLE GATE<br/>Accept or reject?"]

    subgraph SELECT["Signal Landscape → Strategy Selection"]
        SEL1{"Amygdala urgency?"}
        SEL2{"BG routine confidence<br/>> 0.85?"}
        SEL3{"Cerebellum prediction<br/>accuracy < 0.4?"}
        SEL4{"NE level?"}
    end

    subgraph DELIBERATIVE["DELIBERATIVE — Careful"]
        D1["Cycles as long as needed<br/>(no hardcoded limit)"]
        D2["Build, evaluate, resolve,<br/>revise, repeat"]
        D3["Stops when gate accepts<br/>or SOL says ceiling reached"]
        D4["Used when: urgency, high NE,<br/>low prediction accuracy"]
    end

    subgraph DEMOCRATIC["DEMOCRATIC — Balanced"]
        DM1["Weighted majority acceptance<br/>(≥70% stake-weighted)"]
        DM2["Each sense votes:<br/>acceptable or not"]
        DM3["Balances competing<br/>perspectives by influence"]
        DM4["Used when: moderate NE,<br/>low prediction + low NE"]
    end

    subgraph EXPEDIENT["EXPEDIENT — Fast"]
        EX1["Fewer senses activated"]
        EX2["Higher individual<br/>acceptance thresholds"]
        EX3["One revision cycle max"]
        EX4["Used when: low NE,<br/>high routine confidence"]
    end

    GATE --> SEL1
    SEL1 -->|yes| DELIBERATIVE
    SEL1 -->|no| SEL2
    SEL2 -->|yes| EXPEDIENT
    SEL2 -->|no| SEL3
    SEL3 -->|"yes + NE < 0.3"| DEMOCRATIC
    SEL3 -->|"yes + NE ≥ 0.3"| DELIBERATIVE
    SEL3 -->|no| SEL4
    SEL4 -->|"> 0.7 or absent"| DELIBERATIVE
    SEL4 -->|"< 0.3"| EXPEDIENT
    SEL4 -->|"0.3–0.7"| DEMOCRATIC

    style DELIBERATIVE fill:#1a1d27,stroke:#f87171,color:#e2e4ea
    style DEMOCRATIC fill:#1a1d27,stroke:#7c6af0,color:#e2e4ea
    style EXPEDIENT fill:#1a1d27,stroke:#4ade80,color:#e2e4ea
    style SELECT fill:#1a1d27,stroke:#60a5fa,color:#e2e4ea
