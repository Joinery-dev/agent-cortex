---
title: "Consultation — Sensory Cortex Judgment System"
scope: feature
phase: 2
feature: 9
---
flowchart TD
    subgraph DISPATCH["Task Dispatch (what it gives up)"]
        sched["Scheduler.decide()"]
        ne_mode["NE level + mode"]
        sched --> ne_mode
    end

    subgraph SENSORY["Sensory Cortex .prepare — owns all of this now"]
        direction TB

        subgraph INHIBITION["① Inhibit — pulled FROM task-dispatch"]
            inhib_brief["Thalamus.forInhibition(\ntask, NE, mode)"]
            suppress["BasalGanglia.selectAction('task')"]
            active["Thalamus.getActiveSenses()"]
            inhib_brief --> suppress
            suppress -->|"writes WM"| active
        end

        subgraph CONSULTATION["② Consult — per-sense, not per-task"]
            direction TB
            per_sense["For each active sense:"]
            thal_sense["Thalamus.forConsultation(\ntask) / forConsultationFromGestalt(\ntaskId)"]

            subgraph BRIEFING["Per-Sense Briefing"]
                direction LR
                core["Core\ntask + intent + taste"]
                sense_enrich["Sense Enrichment\nown trends, relevant\npatterns, project\nsummary slot"]
                landscape["Landscape\nactive senses,\ninhibited, open Qs"]
                modulation["Modulation\nNE level, mode"]
            end

            per_sense --> thal_sense
            thal_sense --> BRIEFING

            llm_call["LLM: sense identity +\nmodulated system prompt +\nper-sense briefing"]
            BRIEFING --> llm_call
        end

        subgraph MODULATED_PROMPT["System Prompt Adapts"]
            direction LR
            high_ne["High NE:\nbe thorough,\nsurface subtle risks"]
            low_ne["Low NE:\nbe concise,\nfollow patterns"]
            explore["Explore:\nthink beyond obvious,\nunconventional angles"]
            leverage["Leverage:\nwhat's worked,\nwhat to repeat"]
        end

        INHIBITION --> CONSULTATION
        modulation -.->|"drives"| MODULATED_PROMPT
    end

    subgraph PRODUCES["③ Council — richer output"]
        direction TB
        perspectives["SensePerspective[]\nperspective + evaluators + stake\n(unchanged)"]
        council_meta["consultationMeta\nNE, mode, inhibited senses,\nstake distribution"]
        perspectives ~~~ council_meta
    end

    subgraph DOWNSTREAM["What consumes the Council"]
        direction TB
        motor["Motor Cortex\nreads perspectives +\nknows consultation context"]
        eval_gate["Build Cycle Gate\nNE now actually arrives\n(was always undefined)"]
        build_ne["BuildCycleContext.neLevel\nfinally threaded through"]
    end

    ne_mode -->|"real typed fields\nnot Record bag"| SENSORY
    CONSULTATION --> PRODUCES
    PRODUCES --> motor
    ne_mode -->|"threaded through\nSensoryCortexContext"| build_ne
    build_ne --> eval_gate

