flowchart TD
    subgraph VITALS["7 VITAL SIGNS — Continuously Monitored"]
        V1["Working Memory Load<br/>How full is the scratchpad?<br/>Reflex: rest + prune"]
        V2["Prediction Accuracy<br/>Is the Cerebellum calibrated?<br/>Reflex: rest + recalibrate"]
        V3["Context Capacity<br/>Is the context window pressured?<br/>Reflex: breathing (compress briefings)"]
        V4["Budget Utilization<br/>How much budget is spent?<br/>Reflex: economic gate + model downgrade"]
        V5["Learning Signal Health<br/>Is dopamine flowing?<br/>No reflex — flags PFC"]
        V6["Weight Volatility<br/>Are plastic weights oscillating?<br/>Reflex: rest + settle"]
        V7["Tonic Dopamine<br/>Is the project rewarding overall?<br/>No reflex — flags PFC"]
    end

    subgraph LOAD["CONSOLIDATION LOAD — Triggers Rest"]
        L1["Episode density<br/>Uncrystallized episodes<br/>accumulating"]
        L2["Memory pressure<br/>WM overflow without<br/>hippocampal promotion"]
        L3["Prediction drift<br/>Systematic Cerebellum<br/>miscalibration"]
        L4["Weight instability<br/>Plastic weights<br/>oscillating"]
        L5["Deferred processing<br/>Phase gate checks +<br/>deep drift pending"]
    end

    subgraph REST["REST CYCLE — NE Drops to 0"]
        R1["POTENTIATE<br/>Cluster episodes,<br/>extract principles"]
        R2["PRUNE MEMORY<br/>Promote to hippocampus<br/>or drop from WM"]
        R3["DECAY CONNECTIONS<br/>Weaken unused or<br/>unstable plastic weights"]
