        R6["DECAY ROUTINES<br/>Forget unused BG<br/>sense activation patterns"]
        R7["DEFERRED CHECKS<br/>Phase gate integration,<br/>deep drift analysis"]
    end

    VITALS -->|"out of range"| REFLEX["Automatic reflex response<br/>(brainstem level, no PFC needed)"]
    LOAD -->|"load high enough"| REST
    REST --> RESUME["Resume task dispatch<br/>with refreshed state"]

    R1 --> R2 --> R3 --> R4 --> R5 --> R6 --> R7

