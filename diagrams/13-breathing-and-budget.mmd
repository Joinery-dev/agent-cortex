flowchart TD
    TITLE["<b>BREATHING & BUDGET</b><br/>How the system manages cost and context pressure"]
    style TITLE fill:#f8fafc,stroke:#94a3b8,color:#1a1a2e

    TITLE --> BUDGET

    subgraph BUDGET["COST TRACKING — every LLM call recorded"]
        B1["token count × model rate<br/>per-task + per-project totals"]
        B2["Budget utilization =<br/>spent / total budget"]
        B3{"Utilization<br/>level?"}
    end

    B1 --> B2 --> B3

    subgraph NORMAL["< 85% — normal operation"]
        N1["Full briefing depth"]
        N2["Best model available"]
        N3["All relevant senses active"]
    end

    subgraph PRESSURED["≥ 85% — homeostasis tighten-budget reflex"]
        P1["Briefing depth: standard → compressed → minimal"]
        P2["Model downgrade if available"]
        P3["Cerebellum SOL check:<br/>stop early if ceiling too low<br/>vs remaining budget"]
    end

    subgraph EXHAUSTED["> 100% — budget exhausted"]
        EX1["Hard stop: deliver what's done"]
        EX2["Scheduler returns 'complete'<br/>regardless of task graph state"]
    end

    B3 -->|"< 85%"| NORMAL
    B3 -->|"≥ 85%"| PRESSURED
    B3 -->|"> 100%"| EXHAUSTED

    subgraph BREATHING["BREATHING REFLEX — three mechanisms"]
        BR1["1. ASSEMBLY-TIME BUDGET<br/>Thalamus constrains what goes<br/>into each briefing based on<br/>BriefingDepth (NE + budget driven)<br/>Levels: full · standard · compressed · minimal"]
        BR2["2. COMPACTION CONFIG<br/>Thalamus generates custom<br/>instructions for API's<br/>server-side compaction summarizer"]
        BR3["3. POST-COMPACTION REHYDRATION<br/>Thalamus re-injects from<br/>WM, Hippocampus, World Model<br/>after context shrinks"]
    end

    BR1 --> BR2 --> BR3

    PRESSURED --> BREATHING

    NOTE["Key insight: Anthropic handles<br/>context eviction (compaction).<br/>The Thalamus handles what goes IN<br/>(budget) and what survives OUT<br/>(rehydration). The Cerebellum<br/>predicts quality impact of<br/>compression."]

