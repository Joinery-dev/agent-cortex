    WM --> Thalamus
    WM --> DriftMon
    WM --> Attention
    WM --> Inhibitor
    WM --> Flex
    PM --> Attention
    PM --> Thalamus

    classDef done fill:#d5e8d4,stroke:#82b366,color:#333
    classDef active fill:#fff2cc,stroke:#d6b656,color:#333
    classDef pending fill:#f5f5f5,stroke:#999,color:#666
    classDef blocked fill:#f8cecc,stroke:#b85450,color:#333
    classDef suppressed fill:#f0e0e0,stroke:#cc9999,color:#666
    classDef trigger fill:#dae8fc,stroke:#6c8ebf,color:#333
    classDef fired fill:#d5e8d4,stroke:#82b366,color:#333

    class T1,T2 done
    class T3 active
    class T4 pending
    class T5 blocked
    class X1,X2,X3 suppressed
