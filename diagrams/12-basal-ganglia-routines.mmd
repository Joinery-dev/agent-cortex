---
title: "Basal Ganglia — Learned Shortcuts"
scope: global
---
flowchart TD
    TITLE["<b>BASAL GANGLIA — LEARNED SHORTCUTS</b><br/>How the system develops intuition from experience"]
    style TITLE fill:#f8fafc,stroke:#94a3b8,color:#1a1a2e

    TITLE --> TASK["New task arrives"]

    subgraph MATCH["ROUTINE MATCHING"]
        M1["Extract task fingerprint<br/>(keywords + sense activation pattern)"]
        M2["Search routine store<br/>for nearest match by similarity"]
        M3{"Confidence ≥<br/>threshold?"}
    end

    TASK --> M1 --> M2 --> M3

    subgraph DIRECT["DIRECT PATHWAY — shortcut"]
        D1["Activate learned sense set<br/>(skip full deliberation)"]
        D2["'Marketing landing pages<br/>→ always activate Design,<br/>Intent, SEO, Performance'"]
        D3["Fast: no LLM call needed"]
    end

    subgraph HYPER["HYPERDIRECT PATHWAY — deliberation"]
        H1["LLM reasons about which<br/>senses to activate/suppress"]
        H2["Full analysis of task<br/>against all 14 senses"]
        H3["Slower but thorough:<br/>for novel or risky tasks"]
    end

    M3 -->|"yes"| DIRECT
    M3 -->|"no"| HYPER

    subgraph GATE["EXPLORE / EXPLOIT GATE"]
        G1{"Strong routine +<br/>high confidence?"}
        G2["EXPLOIT<br/>Skip explore phase,<br/>use known approach<br/>Thalamus reinforces patterns"]
        G3["EXPLORE<br/>Generate divergent paths<br/>before building<br/>Thalamus de-emphasizes patterns"]
    end

    DIRECT --> G1
    HYPER --> G1
    G1 -->|"yes"| G2
    G1 -->|"no"| G3

    G2 & G3 --> BUILD["Build cycle runs"]
    BUILD --> EVAL["Evaluation + dopamine"]

    subgraph LEARN["LEARNING VIA STRIATAL DOPAMINE"]
        L1["POSITIVE dopamine<br/>→ strengthen routine<br/>(this sense set worked)"]
        L2["NEGATIVE dopamine<br/>→ weaken routine<br/>(sense set missed something)"]
        L3["NOVEL pattern stabilizes<br/>→ create new routine<br/>(starts at 0.5 confidence)"]
    end

    EVAL --> LEARN

    NOTE["Over many projects:<br/>routines stabilize into<br/>the system's intuition.<br/>Immature: all hyperdirect.<br/>Mature: mostly direct."]

    style MATCH fill:#bfdbfe,stroke:#2563eb,color:#1a1a2e
    style DIRECT fill:#d1fae5,stroke:#059669,color:#1a1a2e
    style HYPER fill:#e8e0f0,stroke:#7c6af0,color:#1a1a2e
    style GATE fill:#fef9c3,stroke:#ca8a04,color:#1a1a2e
    style LEARN fill:#ffedd5,stroke:#ea580c,color:#1a1a2e
    style NOTE fill:#fef9c3,stroke:#ca8a04,color:#1a1a2e
