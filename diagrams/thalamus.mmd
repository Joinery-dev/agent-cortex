---
title: "Thalamus — Central Context Relay"
---
flowchart TB
    %% ─── SOURCES ────────────────────────────────────────
    subgraph SRC["📥 SOURCES"]
        direction LR
        IT["Intent + Taste\n<small>what we're building,\nhow we like it</small>"]
        WM["Working Memory\n<small>patterns · decisions · trends\ninhibitions · questions</small>"]
        PNS["PNS\n<small>available tools\n+ capabilities</small>"]
        FUT["Future Sources\n<small>episodes · predictions\nroutines · arousal</small>"]
    end

    %% ─── THALAMUS ───────────────────────────────────────
    subgraph THAL["🔀 THALAMUS"]
        direction TB

        subgraph L1["Layer 1: Categorical Getters — stable API, any consumer can compose"]
            direction LR
            gPC["getProject\nContext()"]
            gAC["getAccumulated\nContext()"]
            gCC["getCapability\nContext()"]
            gAS["getActive\nSenses()"]
        end

        subgraph L2["Layer 2: Convenience Composers — encode selection intelligence"]
            direction LR
            fC["for\nConsultation"]
            fM["for\nMotor"]
            fE["for\nEvaluation"]
            fS["for\nScheduling"]
        end

        L1 --> L2
    end

    %% Source → Getter edges
    IT --> gPC
    WM --> gAC
    WM --> gAS
    PNS --> gCC
    FUT -.-> L1

    %% ─── BRIEFINGS ──────────────────────────────────────
    subgraph BRIEF["📤 PER-CONSUMER BRIEFINGS"]
        direction TB
        CB["Consultation Briefing\n──────────────────\ntask · intent · taste\n<b>+ patterns established</b>\n<b>+ decisions made</b>\n<b>+ all sense trends</b>\n<b>+ inhibited senses</b>\n<b>+ open questions</b>"]
        MB["Motor Briefing\n──────────────────\ntask · intent · taste\n<b>+ council perspectives</b>\n<b>+ patterns established</b>\n<b>+ decisions made</b>\n<b>+ score trends</b>\n<b>+ open questions</b>\n<b>+ PNS capabilities</b>"]
        EB["Evaluation Briefing\n──────────────────\n<b>receptor's own trend</b>\n<b>+ related patterns</b>\n<small>(intentionally minimal —\nfocus on the work)</small>"]
        SB["Scheduling Briefing\n──────────────────\ntask statuses\n<b>+ sense trends</b>\n<b>+ vital signs</b>\n<b>+ open questions</b>"]
    end

    fC --> CB
    fM --> MB
    fE --> EB
    fS --> SB

    %% ─── RHYTHM PHASES ──────────────────────────────────
    subgraph RHYTHM["🎯 RHYTHM PHASES"]
        direction LR
        R1["sensory-cortex\nprepare"]
        R2["build-cycle\nprepare"]
        R3["build-cycle\nintegrate"]
        R4["task-dispatch\nprepare"]
    end

    CB --> R1
    MB --> R2
    EB --> R3
    SB --> R4

    %% ─── FUTURE CONSUMERS ──────────────────────────────
    subgraph FCONSUME["🔮 FUTURE CONSUMERS — compose directly from Layer 1"]
        direction LR
        DM["Drift\nMonitor"]
        CR["Hippocampus\nCrystallization"]
        CE["Cerebellum\nPredict"]
        BG["Basal Ganglia\nMatch"]
    end

    gPC -.-> FCONSUME
    gAC -.-> FCONSUME

    %% ─── THE FILTER ─────────────────────────────────────
    FILTER["getActiveSenses()\nInhibited senses\nnever get consulted"]

    gAS --> FILTER
    FILTER -->|"filtered\nsense list"| R1

    %% ─── STYLES ─────────────────────────────────────────
    classDef source fill:#dae8fc,stroke:#6c8ebf,color:#333
    classDef getter fill:#fff2cc,stroke:#d6b656,color:#333
    classDef composer fill:#e1d5e7,stroke:#9673a6,color:#333
    classDef briefing fill:#fff,stroke:#666,color:#333
    classDef rhythm fill:#d5e8d4,stroke:#82b366,color:#333
    classDef future fill:#f5f5f5,stroke:#bbb,color:#888
    classDef filter fill:#f8cecc,stroke:#b85450,color:#333

    class IT,WM,PNS source
    class FUT future
    class gPC,gAC,gCC,gAS getter
    class fC,fM,fE,fS composer
    class CB,MB,EB,SB briefing
    class R1,R2,R3,R4 rhythm
    class DM,CR,CE,BG future
    class FILTER filter
